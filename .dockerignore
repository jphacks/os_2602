# =============================================================================
# Dockerの箱に入れないもの(.gitignore とは別物)
#   目的1: .env を箱に焼き込まない(配布した相手にパスワードが渡るため)
#   目的2: 不要なファイルを渡さないほどビルドが速い
# =============================================================================

# --- 秘密のもの ---
.env
.env.local
*.pem
*.key

# --- Gitの管理データ(箱の中では不要。意外と大きい) ---
.git
.gitignore

# --- Pythonの作業ファイル ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Django ---
staticfiles/
media/

# --- 開発ツールのキャッシュ ---
.ruff_cache/
.pytest_cache/
.mypy_cache/

# コメントを消す道具が取る写し(箱の中では不要)。
tools/.comment_backup/

# --- エディタ / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- ドキュメント(動作に不要) ---
docs/
README.md

# --- ログや一時ファイル ---
*.log
logs/
tmp/
